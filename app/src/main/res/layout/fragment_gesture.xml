<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/gesture_heading" android:textAppearance="@style/TextAppearance.AlertGeste.Title" android:accessibilityHeading="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/gesture_safe_training" android:textAppearance="@style/TextAppearance.AlertGeste.Body" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" app:cardBackgroundColor="@color/colorSurfaceTint" app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="24dp" android:gravity="center_horizontal">
                <TextView android:id="@+id/tv_count" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/gesture_initial_count" android:textSize="56sp" android:textStyle="bold"
                    android:textColor="@color/colorPrimary" android:gravity="center" android:accessibilityLiveRegion="polite" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/shakes_detected" android:gravity="center" android:textAppearance="@style/TextAppearance.AlertGeste.Body" />
                <TextView android:id="@+id/instructions" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:gravity="center" android:textAppearance="@style/TextAppearance.AlertGeste.Body"
                    android:accessibilityLiveRegion="polite" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:id="@+id/sensor_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/sensor_connecting" android:textAppearance="@style/TextAppearance.AlertGeste.Body" />
        <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress_magnitude"
            android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="12dp"
            android:max="100" android:importantForAccessibility="no" app:trackThickness="8dp"
            app:trackCornerRadius="4dp" app:trackColor="@color/colorSurfaceTint" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_reset_calibration"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/start_calibration" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_done"
            style="@style/Widget.AlertGeste.OutlineButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/back_home" android:visibility="gone" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="@string/gesture_hint" android:textAppearance="@style/TextAppearance.AlertGeste.Body" android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
