<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name"
            android:textColor="@color/colorPrimary" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/home_heading" android:textAppearance="@style/TextAppearance.AlertGeste.Title" android:accessibilityHeading="true" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" app:cardBackgroundColor="@color/colorSurfaceTint" app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:id="@+id/tv_status_text" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/surveillance_inactive" android:textSize="21sp" android:textStyle="bold" android:accessibilityLiveRegion="polite" />
                <TextView android:id="@+id/tv_readiness" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:textAppearance="@style/TextAppearance.AlertGeste.Body" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_toggle_surveillance"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:text="@string/activer_surveillance" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_sos_manuel"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="80dp"
            android:layout_marginTop="24dp" android:text="@string/manual_sos" android:textSize="19sp"
            android:textColor="@color/white" app:backgroundTint="@color/colorDangerFill" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/sos_explanation" android:gravity="center"
            android:textAppearance="@style/TextAppearance.AlertGeste.Body" android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_cancel_alert"
            style="@style/Widget.AlertGeste.OutlineButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/cancel_before_send" android:visibility="gone" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:layout_marginBottom="8dp" android:text="@string/prepare_protection"
            android:textSize="19sp" android:textStyle="bold" android:accessibilityHeading="true" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_contacts"
            app:icon="@drawable/ic_people_outline" app:iconPadding="16dp"
            style="@style/Widget.AlertGeste.OutlineButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="start|center_vertical"
            android:paddingStart="20dp" android:paddingEnd="20dp" android:text="@string/contacts" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_gesture"
            app:icon="@drawable/ic_gesture_outline" app:iconPadding="16dp"
            style="@style/Widget.AlertGeste.OutlineButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="start|center_vertical"
            android:paddingStart="20dp" android:paddingEnd="20dp" android:text="@string/configurer_geste" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_history"
            app:icon="@drawable/ic_history_outline" app:iconPadding="16dp"
            style="@style/Widget.AlertGeste.OutlineButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="start|center_vertical"
            android:paddingStart="20dp" android:paddingEnd="20dp" android:text="@string/historique" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_settings"
            app:icon="@drawable/ic_settings_outline" app:iconPadding="16dp"
            style="@style/Widget.AlertGeste.OutlineButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="start|center_vertical"
            android:paddingStart="20dp" android:paddingEnd="20dp" android:text="@string/paramètres" />
    </LinearLayout>
</ScrollView>
